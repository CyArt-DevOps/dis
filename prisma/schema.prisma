generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // TiDB Cloud Serverless: foreign keys are emulated by Prisma rather than
  // enforced in the database. This is the configuration TiDB documents for
  // Prisma, and it keeps migrations from depending on FK support. The cost is
  // that referential actions (the cascade on MeetingAttendance) run in the
  // client, so writes must go through Prisma — which they all do.
  relationMode = "prisma"
}

model Member {
  id        String   @id // discord user id
  guildId   String
  tag       String?
  fullName  String?
  displayName String?
  batch     String?
  project   String?
  module    Int?
  pod       Int?
  registrationDate DateTime?
  verificationStatus String @default("pending") // pending | verified
  flagged   Boolean @default(false) // possible duplicate name, for HR review
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  voiceSessions VoiceSession[]
  attendance    Attendance[]

  @@unique([guildId, id])
  @@index([guildId])
}

model Ticket {
  id         Int       @id @default(autoincrement())
  guildId    String
  channelId  String?
  type       String
  subject    String @db.Text
  openerId   String
  claimedById String?
  status     String    @default("open") // open | claimed | closed
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById String?

  @@index([guildId, status])
  @@index([openerId])
}

model VoiceSession {
  id        Int       @id @default(autoincrement())
  guildId   String
  userId    String
  channelId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  seconds   Int?      // seconds credited to Attendance so far (checkpointed)
  // High-water mark of time already credited. The flush sweep advances this
  // every minute so a crash loses at most one sweep instead of a whole session,
  // and so open sessions show up in "today" totals while still connected.
  creditedUpTo DateTime?

  member Member? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([guildId, userId])
  @@index([guildId, joinedAt])
  @@index([leftAt])
  @@index([guildId, channelId, joinedAt])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  guildId String
  userId  String
  day     String // YYYY-MM-DD
  seconds Int    @default(0)

  member Member? @relation(fields: [userId], references: [id])

  @@unique([guildId, userId, day])
  @@index([userId])
  @@index([guildId, day])
}

model Warn {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  modId     String
  reason    String @db.Text
  createdAt DateTime @default(now())
  // auto (attendance sweep) | manual (dashboard) | command (/warn)
  source    String   @default("command") @db.VarChar(16)
  // hours (short/absent days) | conduct | other
  kind      String   @default("other") @db.VarChar(16)
  // proposed (awaiting HR review) | sent | dm-failed | acknowledged | dismissed
  status    String   @default("sent") @db.VarChar(16)
  // CSV of YYYY-MM-DD days an hours warning covers, so a streak is warned once
  days      String?  @db.Text
  issuedBy  String?  @db.VarChar(80)
  sentAt    DateTime?
  ackDueAt  DateTime?
  acknowledgedAt DateTime?
  dmChannelId String? @db.VarChar(32)
  dmMessageId String? @db.VarChar(32)

  @@index([guildId, userId])
  @@index([guildId, status])
}

/// Org-wide non-working days. They count like weekends everywhere.
model Holiday {
  id        Int      @id @default(autoincrement())
  guildId   String
  day       String   @db.VarChar(10) // YYYY-MM-DD
  name      String   @db.VarChar(120)
  addedBy   String?  @db.VarChar(80)
  createdAt DateTime @default(now())

  @@unique([guildId, day])
}

/// Members removed for non-compliance (three warnings). Audit trail.
model Termination {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  fullName  String?  @db.VarChar(191)
  reason    String   @db.Text
  warnIds   String?  @db.Text // CSV of the warnings that triggered it
  by        String   @db.VarChar(80)
  kicked    Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([guildId, userId])
}

model VoiceGrant {
  id         Int       @id @default(autoincrement())
  guildId    String
  userId     String
  channelId  String
  grantedById String
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([guildId, revoked])
}

model Meeting {
  id              Int      @id @default(autoincrement())
  guildId         String
  title           String
  description     String? @db.Text
  organizerId     String
  startAt         DateTime // UTC
  durationMin     Int
  audienceType    String   // org | batch | project | module | pod | people
  audienceBatch   String?
  audienceProject String?  // project key
  audienceModule  Int?
  audiencePod     Int?
  audienceMemberIds String? @db.Text // CSV of Discord user IDs, only set when audienceType = people
  office          String?  // manager | hr, only set when audienceType = people
  notifyChannelId String?  // private meeting-<id> channel for people-audience notifications
  voiceChannelId  String
  mandatory       Boolean  @default(true)
  attendanceWindowMin Int  @default(10)
  reminderIntervalMin Int? // optional extra custom reminder
  // MySQL forbids a DEFAULT on TEXT, so this stays a sized VARCHAR. The value
  // is a short CSV of reminder keys (longest seen: 19 chars).
  remindersSent   String   @default("") @db.VarChar(500)
  status          String   @default("scheduled") // scheduled | monitoring | completed | cancelled
  createdAt       DateTime @default(now())

  attendance MeetingAttendance[]

  @@index([guildId, status])
  @@index([startAt])
}

model MeetingAttendance {
  id            Int      @id @default(autoincrement())
  meetingId     Int
  userId        String
  fullName      String?
  batch         String?
  project       String?
  module        Int?
  pod           Int?
  scheduledStart DateTime
  actualJoinAt  DateTime?
  leaveStatus   String?  // none | approved
  status        String   // present | late | absent | excused
  minutesLate   Int      @default(0)
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

model LeaveRequest {
  id           Int      @id @default(autoincrement())
  guildId      String
  userId       String
  type         String   @default("casual") // casual | sick | exam
  startAt      DateTime // UTC (date + start time)
  endAt        DateTime // UTC (date + end time)
  reason       String @db.Text
  documentUrl  String? @db.Text // medical certificate / exam timetable
  channelId    String?  // private HR leave ticket channel
  approvedDays String? @db.Text // CSV YYYY-MM-DD (exam leave only) — otherwise range applies
  status       String   @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([guildId, status])
  @@index([userId, status])
}

model ScheduledMessage {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  authorId    String // who ran /schedule — always the credited author
  content     String @db.Text
  sendAt      DateTime // UTC
  status      String   @default("pending") // pending | sent | cancelled | failed
  sentAt      DateTime?
  messageId   String? // delivered message, for reference
  error       String? @db.Text // failure reason when status = failed
  createdAt   DateTime @default(now())

  @@index([status, sendAt])
  @@index([guildId, authorId, status])
}
