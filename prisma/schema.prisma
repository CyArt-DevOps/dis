generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id // discord user id
  guildId   String
  tag       String?
  fullName  String?
  displayName String?
  batch     String?
  project   String?
  module    Int?
  pod       Int?
  registrationDate DateTime?
  verificationStatus String @default("pending") // pending | verified
  flagged   Boolean @default(false) // possible duplicate name, for HR review
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  voiceSessions VoiceSession[]
  attendance    Attendance[]

  @@unique([guildId, id])
  @@index([guildId])
}

model Ticket {
  id         Int       @id @default(autoincrement())
  guildId    String
  channelId  String?
  type       String
  subject    String
  openerId   String
  claimedById String?
  status     String    @default("open") // open | claimed | closed
  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById String?

  @@index([guildId, status])
  @@index([openerId])
}

model VoiceSession {
  id        Int       @id @default(autoincrement())
  guildId   String
  userId    String
  channelId String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  seconds   Int?      // seconds credited to Attendance so far (checkpointed)
  // High-water mark of time already credited. The flush sweep advances this
  // every minute so a crash loses at most one sweep instead of a whole session,
  // and so open sessions show up in "today" totals while still connected.
  creditedUpTo DateTime?

  member Member? @relation(fields: [userId], references: [id])

  @@index([guildId, userId])
  @@index([guildId, joinedAt])
  @@index([leftAt])
  @@index([guildId, channelId, joinedAt])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  guildId String
  userId  String
  day     String // YYYY-MM-DD
  seconds Int    @default(0)

  member Member? @relation(fields: [userId], references: [id])

  @@unique([guildId, userId, day])
  @@index([guildId, day])
}

model Warn {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  modId     String
  reason    String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
}

model VoiceGrant {
  id         Int       @id @default(autoincrement())
  guildId    String
  userId     String
  channelId  String
  grantedById String
  expiresAt  DateTime
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([guildId, revoked])
}

model Meeting {
  id              Int      @id @default(autoincrement())
  guildId         String
  title           String
  description     String?
  organizerId     String
  startAt         DateTime // UTC
  durationMin     Int
  audienceType    String   // org | batch | project | module | pod | people
  audienceBatch   String?
  audienceProject String?  // project key
  audienceModule  Int?
  audiencePod     Int?
  audienceMemberIds String? // CSV of Discord user IDs, only set when audienceType = people
  office          String?  // manager | hr, only set when audienceType = people
  notifyChannelId String?  // private meeting-<id> channel for people-audience notifications
  voiceChannelId  String
  mandatory       Boolean  @default(true)
  attendanceWindowMin Int  @default(10)
  reminderIntervalMin Int? // optional extra custom reminder
  remindersSent   String   @default("") // CSV of fired reminder keys
  status          String   @default("scheduled") // scheduled | monitoring | completed | cancelled
  createdAt       DateTime @default(now())

  attendance MeetingAttendance[]

  @@index([guildId, status])
  @@index([startAt])
}

model MeetingAttendance {
  id            Int      @id @default(autoincrement())
  meetingId     Int
  userId        String
  fullName      String?
  batch         String?
  project       String?
  module        Int?
  pod           Int?
  scheduledStart DateTime
  actualJoinAt  DateTime?
  leaveStatus   String?  // none | approved
  status        String   // present | late | absent | excused
  minutesLate   Int      @default(0)
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

model LeaveRequest {
  id           Int      @id @default(autoincrement())
  guildId      String
  userId       String
  type         String   @default("casual") // casual | sick | exam
  startAt      DateTime // UTC (date + start time)
  endAt        DateTime // UTC (date + end time)
  reason       String
  documentUrl  String?  // medical certificate / exam timetable
  channelId    String?  // private HR leave ticket channel
  approvedDays String?  // CSV YYYY-MM-DD (exam leave only) — otherwise range applies
  status       String   @default("pending") // pending | approved | rejected
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([guildId, status])
  @@index([userId, status])
}

model ScheduledMessage {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  authorId    String // who ran /schedule — always the credited author
  content     String
  sendAt      DateTime // UTC
  status      String   @default("pending") // pending | sent | cancelled | failed
  sentAt      DateTime?
  messageId   String? // delivered message, for reference
  error       String? // failure reason when status = failed
  createdAt   DateTime @default(now())

  @@index([status, sendAt])
  @@index([guildId, authorId, status])
}
