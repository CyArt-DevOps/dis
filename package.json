{
  "name": "intern-org-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Discord management system for intern organization (500-1000+ members).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register": "tsx scripts/register-commands.ts",
    "build:server": "tsx scripts/build-server.ts",
    "fix:perms": "tsx scripts/fix-permissions.ts",
    "dashboard": "tsx scripts/export-dashboard.ts",
    "repair:attendance": "tsx scripts/repair-attendance.ts",
    "resync:members": "tsx scripts/resync-members.ts",
    "create:module-info": "tsx scripts/create-module-info.ts",
    "clean:grc20": "tsx scripts/clean-grc20-duplicate.ts",
    "seed:info": "tsx scripts/seed-info.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "web": "tsx src/web/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ui": "npm --prefix webui run build",
    "dev:ui": "npm --prefix webui run dev",
    "postinstall": "prisma generate",
    "db:snapshot": "tsx scripts/db-snapshot.ts",
    "db:tidb:copy": "tsx scripts/migrate-to-tidb.ts",
    "db:sqlite:generate": "prisma generate --schema prisma/sqlite-source.prisma",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "db:verify": "tsx scripts/verify-backup.ts",
    "start:supervised": "node scripts/supervise.mjs",
    "db:renumber": "tsx scripts/renumber-ids.ts",
    "db:renumber:discord": "tsx scripts/fix-discord-after-renumber.ts",
    "db:fix-autoid": "tsx scripts/fix-auto-id-cache.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "uuid": "^14.0.3",
    "undici": "^6.29.0",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.0",
    "fast-copy": "^3.1.0",
    "brace-expansion": "^1.1.21",
    "nanoid": "^3.3.20",
    "postcss": "^8.5.30",
    "source-map-js": "^1.2.2"
  }
}
