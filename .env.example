# Copy to .env and fill in. Never commit the real file.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1491834973416591370
DISCORD_GUILD_ID=1520702519049982042

# --- Database ---
# Path is relative to the prisma/ directory.
DATABASE_URL=file:./data/app.db?connection_limit=1&socket_timeout=20

# --- Dashboard ---
# WEB_HOST unset  -> loopback only, no password needed (local development).
# WEB_HOST=0.0.0.0 -> publicly bound; WEB_PASSWORD is then REQUIRED or the
#                     dashboard refuses to start.
# WEB_PORT falls back to SERVER_PORT, which the hosting panel sets for you.
#WEB_HOST=0.0.0.0
#WEB_PASSWORD=
# Set to 0 only when testing over plain HTTP.
WEB_SECURE_COOKIE=1

LOG_LEVEL=info
NODE_ENV=production

# --- EMS integration (all three unset = off) ---
# Long random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#DIS_API_KEY=
#EMS_API_URL=http://localhost:5000
#INTEGRATION_SECRET=
