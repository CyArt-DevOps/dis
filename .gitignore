node_modules/
webui/node_modules/

# Secrets — never commit. See .env.example for the shape.
.env
.env.*
!.env.example

# Live data and backups: the SQLite database is uploaded to the host directly,
# not versioned.
prisma/data/*
!prisma/data/.gitkeep
data/*.db
data/*.db-*
data/*.bak-*
data/invites-before-purge.json
data/seed-info.log

*.log
.DS_Store

# NOTE: dist/ and webui/dist ARE committed on purpose. The host runs
# `npm install --production`, which omits typescript and vite, so it cannot
# build anything itself — it only runs what is already compiled here.
prisma/data/snapshot/
generated/
.env.tidb

# The host runs `npm install --production` on every boot, which rewrites this
# file. A tracked, locally-modified lockfile makes the egg's `git pull` abort
# with "local changes would be overwritten" — so AUTO_UPDATE silently stops
# deploying and the server keeps running stale code. Untracked, the rewrite is
# harmless. Dependency pinning that must survive lives in package.json
# (`overrides`), not here.
package-lock.json

# Database backups: real member data, never committed.
backups/
logs/
renumber-map.json
